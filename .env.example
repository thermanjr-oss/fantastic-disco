# Database (Postgres) — Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/productivity_os"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth (console.cloud.google.com — redirect URI: $NEXTAUTH_URL/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (github.com/settings/developers — callback URL: $NEXTAUTH_URL/api/auth/callback/github)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email sign-in (optional — omit both to disable the email provider)
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="Productivity OS <noreply@example.com>"

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Cron sweep auth — set the same value here and in your scheduler's Authorization header
CRON_SECRET="generate-a-random-string"

# Per-user AI keys are entered in Settings and stored in the DB — no global key needed here.
